      "css": ".ds-panel{width:360px;background:#0e1014;border:1px solid #1d2027;border-radius:12px;color:#e8ebf0;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;}.ds-ph{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px 0;min-height:44px}.ds-ph h2{margin:0;font-size:14px;font-weight:600}.ds-ph span{font-size:12px;color:#8b94a4}.ds-pb{padding:14px 18px 18px;font-size:14px}"
