      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px;border-radius:7px;font-size:13px;font-weight:550;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;color:#e8ebf0;background:#12151a;border:1px solid #2a2f39;cursor:pointer;transition:background 140ms,border-color 140ms,transform 140ms}.ds-btn:hover{background:#171b22;border-color:#353b47}.ds-btn:active{transform:translateY(1px);background:#1c212a}.ds-btn:focus-visible{outline:2px solid #4d94ff;outline-offset:2px}.ds-btn-ghost{background:transparent;border-color:transparent;color:#b9c0cb}.ds-btn-ghost:hover{background:#171b22;border-color:transparent;color:#e8ebf0}"
