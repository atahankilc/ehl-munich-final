      "kind": "custom",
      "refersTo": "priority-must",
      "description": "Filled = PM-confirmed; dashed + AI = AI suggestion.",
      "html": "<span class=\"ds-pm ds-must\">Must</span> <span class=\"ds-pm ds-should\">Should</span> <span class=\"ds-pm ds-must ds-ai\">Must <i>AI</i></span> <span class=\"ds-pm ds-should ds-ai\">Should <i>AI</i></span>",
      "css": ".ds-pm{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 9px;border-radius:6px;font-size:11.5px;font-weight:650;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;font-stretch:104%}.ds-must{background:#1c69d4;color:#fff}.ds-should{color:#a9cbff;box-shadow:inset 0 0 0 1px rgba(77,148,255,.45)}.ds-ai{box-shadow:none;outline:1px dashed currentColor;outline-offset:-1px}.ds-must.ds-ai{background:rgba(28,105,212,.16);color:#a9cbff;outline-color:#4d94ff}.ds-should.ds-ai{outline-color:rgba(77,148,255,.45)}.ds-pm i{font-style:normal;font-size:9px;font-weight:700;letter-spacing:.06em;opacity:.8}"
    },
    {
      "name": "Evidence Meter + Score Bar",
      "kind": "custom",
      "refersTo": "",
      "description": "Signal bars for evidence; 0-100 bar ticked at Should 45 and Must 60.",
      "html": "<span class=\"ds-ev\"><i class=\"on\" style=\"height:4px\"></i><i class=\"on\" style=\"height:7px\"></i><i class=\"on\" style=\"height:10px\"></i><i style=\"height:13px\"></i></span> <span class=\"ds-sb\"><span class=\"ds-tr\"><span class=\"ds-fill\" style=\"width:72%\"></span><span class=\"ds-tk\" style=\"left:45%\"></span><span class=\"ds-tk\" style=\"left:60%\"></span></span><b>72</b></span>",
      "css": ".ds-ev{display:inline-flex;align-items:flex-end;gap:2px;height:13px;vertical-align:middle}.ds-ev i{display:block;width:3px;border-radius:1px;background:#2a2f39}.ds-ev i.on{background:#3ccf91}.ds-sb{display:inline-flex;align-items:center;gap:8px;margin-left:16px;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;}.ds-tr{position:relative;width:96px;height:4px;border-radius:2px;background:#1e222a}.ds-fill{position:absolute;left:0;top:0;bottom:0;border-radius:2px;background:#4d94ff}.ds-tk{position:absolute;top:-2px;width:1px;height:8px;background:#545c6b}.ds-sb b{font-weight:400;font-size:12.5px;color:#b9c0cb}"
    },
