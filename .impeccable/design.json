      "html": "<span class=\"ds-chip\">Expected</span> <span class=\"ds-chip ds-up\">+4.2</span> <span class=\"ds-chip ds-warn\">small sample</span> <span class=\"ds-chip ds-blue\">AI</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 8px;border-radius:6px;font-size:11.5px;font-weight:600;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;background:rgba(255,255,255,.06);color:#b9c0cb}.ds-up{background:rgba(60,207,145,.13);color:#a6ecc9}.ds-warn{background:rgba(245,165,36,.13);color:#fbd38a}.ds-blue{background:rgba(28,105,212,.16);color:#a9cbff}"
