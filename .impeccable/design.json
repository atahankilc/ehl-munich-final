      "css": ".ds-tt{display:inline-flex;align-items:center;gap:7px;margin-right:14px;font-size:12px;color:#b9c0cb;font-family:var(--font,'Mona Sans Variable',system-ui,sans-serif);font-variant-numeric:proportional-nums;}.ds-tt::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--tt);box-shadow:0 0 0 3px color-mix(in srgb,var(--tt) 22%,transparent)}"
