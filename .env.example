# Copy to .env (git-ignored) and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6.1-sol
OPENAI_MODEL_EMBED=text-embedding-3-small
RAW_DATA_DIR=challange information document/BMW-Data
DATA_DIR=data

# Profile (D-053): development (API auto-reload, PM app via Vite) | production (API serves frontend/dist)
APP_ENV=development
# API_HOST=127.0.0.1   # keep localhost; containers set 0.0.0.0 themselves and publish on 127.0.0.1 only
# API_PORT=8600
# API_RELOAD=1         # override the profile's reload default
